# Copy to .env. Never commit your actual API key.
OPENAI_API_KEY=
# Set to a text model supporting the Responses API in your OpenAI project.
OPENAI_MODEL=
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Required for NODE_ENV=production. Use a long random reviewer access code.
APP_ACCESS_TOKEN=
NODE_ENV=development
